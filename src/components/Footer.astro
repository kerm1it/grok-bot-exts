---
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/types";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="site-footer">
  <div>
    <strong>{t(locale, "siteName")}</strong>
    <p>{locale === "zh" ? "为两个 Bot 生态提供清晰、可验证的扩展目录。" : "A clear, inspectable extension catalog for two bot ecosystems."}</p>
  </div>
  <a href="https://github.com/kerm1it/grok-bot-exts" target="_blank" rel="noreferrer">
    <Icon name="code" size={17} />
    {t(locale, "openSource")}
  </a>
</footer>

