---
import { entryPath, localized } from "@/lib/catalog";
import { categoryLabel, kindLabel, platformLabel, t } from "@/lib/i18n";
import type { CatalogEntry, Locale } from "@/lib/types";
import Icon from "./Icon.astro";

interface Props {
  entry: CatalogEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
---

<a class="extension-row" href={entryPath(entry, locale)} style={`--entry-accent:${entry.accent}`}>
  <span class="accession-mark" aria-hidden="true"></span>
  <span class="entry-name">
    <strong>{localized(entry.name, locale)}</strong>
    <span>{entry.publisher.name}</span>
  </span>
  <span class="entry-summary">{localized(entry.summary, locale)}</span>
  <span class="entry-meta">
    <span>{platformLabel(locale, entry.platform)} · {kindLabel(locale, entry.kind)}</span>
    <span>{categoryLabel(locale, entry.category)}</span>
  </span>
  <span class="entry-action">
    {entry.official && <span class="status-badge"><Icon name="check" size={13} />{t(locale, "official")}</span>}
    <span>{t(locale, "viewRecord")}</span>
    <Icon name="arrow" size={16} />
  </span>
</a>

