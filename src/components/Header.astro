---
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/types";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const prefix = locale === "zh" ? "/zh" : "";
---

<header class="site-header">
  <a class="brand" href={`${prefix}/`} aria-label={t(locale, "siteName")}>
    <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
    <span>{t(locale, "siteName")}</span>
  </a>
  <nav aria-label={t(locale, "navigation")}>
    <a href={`${prefix}/extensions/`}>{t(locale, "browse")}</a>
    <a href="https://github.com/kerm1it/grok-bot-exts#contributing" target="_blank" rel="noreferrer">
      {t(locale, "contribute")}
    </a>
    <a class="language-link" href={alternatePath} hreflang={locale === "zh" ? "en" : "zh-CN"} aria-label={t(locale, "languageLabel")}>
      <Icon name="globe" size={16} />
      <span>{t(locale, "language")}</span>
    </a>
  </nav>
</header>

