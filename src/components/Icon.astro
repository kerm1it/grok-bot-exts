---
type IconName =
  | "arrow"
  | "bot"
  | "check"
  | "code"
  | "external"
  | "filter"
  | "globe"
  | "plugin"
  | "search"
  | "spark";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  aria-hidden="true"
  class="icon"
  fill="none"
  height={size}
  viewBox="0 0 24 24"
  width={size}
  xmlns="http://www.w3.org/2000/svg"
>
  {name === "search" && <><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></>}
  {name === "arrow" && <><path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path></>}
  {name === "external" && <><path d="M14 5h5v5"></path><path d="m19 5-8 8"></path><path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></>}
  {name === "bot" && <><rect x="5" y="7" width="14" height="11" rx="3"></rect><path d="M12 3v4"></path><circle cx="9" cy="12" r="1"></circle><circle cx="15" cy="12" r="1"></circle><path d="M9 15h6"></path></>}
  {name === "plugin" && <path d="M9 5V3m6 2V3M8 8h8a2 2 0 0 1 2 2v2a6 6 0 0 1-6 6 6 6 0 0 1-6-6v-2a2 2 0 0 1 2-2Zm4 10v3"></path>}
  {name === "check" && <path d="m5 12 4 4L19 6"></path>}
  {name === "code" && <><path d="m9 7-5 5 5 5"></path><path d="m15 7 5 5-5 5"></path></>}
  {name === "globe" && <><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21M12 3C9.6 5.5 8.4 8.5 8.4 12S9.6 18.5 12 21"></path></>}
  {name === "filter" && <><path d="M4 7h10M18 7h2M4 17h2M10 17h10"></path><circle cx="16" cy="7" r="2"></circle><circle cx="8" cy="17" r="2"></circle></>}
  {name === "spark" && <path d="m12 3 1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3Z"></path>}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
</style>

