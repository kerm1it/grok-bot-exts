---
import Icon from "@/components/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Record not found — Bot Extensions" description="The requested extension record is not in the current catalog." locale="en" alternatePath="/zh/">
  <section class="not-found page-width">
    <div>
      <p class="record-code">CATALOG / 404</p>
      <h1>This record is not in the current catalog.</h1>
      <p>The link may point to an extension that was renamed, removed, or has not been contributed yet.</p>
      <a class="button" href="/extensions/">Browse the catalog <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</BaseLayout>

