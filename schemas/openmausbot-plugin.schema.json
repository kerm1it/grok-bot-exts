{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/openmausbot-plugin.schema.json",
  "title": "OpenMausBot plugin",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
    "description": { "$ref": "common.schema.json#/$defs/localizedText" },
    "publisher": { "$ref": "common.schema.json#/$defs/publisher" },
    "official": { "type": "boolean" },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "license": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "entrypoints": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "hooks": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        }
      },
      "required": ["skills"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "publisher",
    "category",
    "tags",
    "entrypoints"
  ],
  "additionalProperties": false
}
