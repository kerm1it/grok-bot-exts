{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/common.schema.json",
  "title": "Common marketplace definitions",
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" }
      },
      "required": ["en"],
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string", "format": "uri" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "fileReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "skill",
            "memory",
            "routine",
            "plugin",
            "command",
            "hook",
            "rule",
            "subagent",
            "mcp-server",
            "attachment"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["type", "name"],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["plugin"] },
        "optional": { "type": "boolean" }
      },
      "required": ["id", "name", "kind", "optional"],
      "additionalProperties": false
    }
  }
}
