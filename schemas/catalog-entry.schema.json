{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/catalog-entry.schema.json",
  "title": "Normalized catalog entry",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "platform": { "type": "string", "enum": ["grok-bot", "openmausbot"] },
    "kind": { "type": "string", "enum": ["bot", "plugin"] },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
    "description": { "$ref": "common.schema.json#/$defs/localizedText" },
    "publisher": { "$ref": "common.schema.json#/$defs/publisher" },
    "official": { "type": "boolean" },
    "verified": { "type": "boolean" },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "sourceLabel": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/capability" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/dependency" }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fileReference" }
    },
    "accent": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" }
  },
  "required": [
    "id",
    "slug",
    "platform",
    "kind",
    "name",
    "summary",
    "description",
    "publisher",
    "official",
    "verified",
    "category",
    "tags",
    "updatedAt",
    "sourceUrl",
    "sourceLabel",
    "capabilities",
    "dependencies",
    "attachments",
    "accent"
  ],
  "additionalProperties": false
}
