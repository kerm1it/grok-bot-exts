{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/openmausbot-bot.schema.json",
  "title": "OpenMausBot bot",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
    "description": { "$ref": "common.schema.json#/$defs/localizedText" },
    "publisher": { "$ref": "common.schema.json#/$defs/publisher" },
    "official": { "const": false },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "license": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        },
        "required": ["id", "optional"],
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "profile": { "$ref": "common.schema.json#/$defs/fileReference" },
        "memory": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "routines": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fileReference" }
        }
      },
      "required": ["profile", "memory", "routines", "skills"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "publisher",
    "category",
    "tags",
    "plugins",
    "entrypoints"
  ],
  "additionalProperties": false
}
