{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/grok-plugin.schema.json",
  "title": "Grok-compatible plugin source entry",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "publisher": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "websiteUrl": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "isPublished": { "type": "boolean" },
    "updatedAt": { "type": "string" },
    "skills": { "type": "array" },
    "commands": { "type": "array" },
    "hooks": { "type": "array" },
    "rules": { "type": "array" },
    "subagents": { "type": "array" },
    "mcpServers": { "type": "array" }
  },
  "required": ["id", "name", "displayName", "repositoryUrl", "publisher", "isPublished"],
  "additionalProperties": true
}
