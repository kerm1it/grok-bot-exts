{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-extensions.dev/schemas/grok-bot.schema.json",
  "title": "Grok Bot source export",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "shareId": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "activeVersion": { "type": ["string", "integer", "null"] },
        "exportedAt": { "type": "string" },
        "files": { "type": "object" }
      },
      "required": ["shareId", "slug", "name"],
      "additionalProperties": true
    },
    "listing": {
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "summary_zh": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "verified": { "type": "boolean" },
        "shareUrl": { "type": "string", "format": "uri" }
      },
      "required": ["slug", "name", "category", "shareUrl"],
      "additionalProperties": true
    },
    "recipe": {
      "type": "object",
      "properties": {
        "profile": { "type": ["object", "null"] },
        "skills": { "type": "array" },
        "memory": { "type": "array" },
        "routines": { "type": "array" },
        "plugins": { "type": "array" }
      },
      "required": ["skills", "memory", "routines", "plugins"],
      "additionalProperties": true
    },
    "template": { "type": "object" }
  },
  "required": ["manifest", "listing", "recipe", "template"],
  "additionalProperties": false
}
